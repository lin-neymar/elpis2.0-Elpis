{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "lib": ["ES2021"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./app",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app/main.ts",
    "app/app.module.ts",
    "app/elpis.module.ts",
    "app/config/**/*.ts",
    "app/common/**/*.ts",
    "app/extend/**/*.ts",
    "app/modules/**/*.ts",
    "app/types/**/*.d.ts"
  ]
}
